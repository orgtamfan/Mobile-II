rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya user yang login dan merupakan pemilik data (uid cocok)
    // yang boleh membaca/menulis dokumen di bawah users/{uid}/...
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /kendaraan/{kendaraanId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /servis/{servisId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /notifikasi/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
