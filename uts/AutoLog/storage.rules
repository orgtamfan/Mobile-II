rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Hanya user login yang boleh read/write foto nota di folder miliknya sendiri.
    // Path: nota_servis/{uid}/{servisId}.jpg
    match /nota_servis/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
