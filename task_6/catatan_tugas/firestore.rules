rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function fotoValid(d) {
      return !('lampiranBase64' in d)
        || (d.lampiranBase64 is string
            && d.lampiranBase64.size() < 300000);
    }

    match /tugas/{tugasId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.judul is string
                    && request.resource.data.judul.size() > 0
                    && request.resource.data.mataKuliah is string
                    && request.resource.data.mataKuliah.size() > 0
                    && fotoValid(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && fotoValid(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /users/{uid}/tokens/{token} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    match /users/{uid} {
      function profilValid(d) {
        return (!('fotoProfil' in d)
                || (d.fotoProfil is string
                    && d.fotoProfil.size() < 100000))
            && (!('notifikasiAktif' in d)
                || d.notifikasiAktif is bool);
      }

      allow read: if request.auth != null
                  && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly([
                      'fotoProfil', 'notifikasiAktif'
                    ])
                    && profilValid(request.resource.data);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly([
                          'fotoProfil', 'notifikasiAktif'
                        ])
                    && profilValid(request.resource.data);
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }
  }
}
